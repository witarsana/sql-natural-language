{
  "name": "chronicle-nl-query-backend",
  "version": "1.0.0",
  "description": "Natural Language to MySQL Query System for Chronicle Cemetery Software",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "chronicle",
    "natural-language",
    "mysql",
    "fastify",
    "ai"
  ],
  "author": "Chronicle Team",
  "license": "PROPRIETARY",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "dotenv": "^16.3.1",
    "fastify": "^4.25.2",
    "knex": "^3.1.0",
    "mysql2": "^3.6.5",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
